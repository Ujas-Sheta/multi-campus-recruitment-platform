{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "mcrp/cta-banner",
	"title": "CTA Banner",
	"description": "High-contrast call-to-action band.",
	"category": "mcrp",
	"icon": "megaphone",
	"keywords": [
		"call to action",
		"apply",
		"button"
	],
	"textdomain": "mcrp",
	"supports": {
		"anchor": true,
		"align": false,
		"html": false,
		"mode": true,
		"jsx": false,
		"customClassName": true
	},
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php",
		"sectionStyle": false
	},
	"example": {
		"attributes": {
			"mode": "preview",
			"data": {
				"heading": "Ready to apply?"
			}
		}
	}
}
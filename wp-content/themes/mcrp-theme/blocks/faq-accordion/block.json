{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "mcrp/faq-accordion",
	"title": "FAQ Accordion",
	"description": "Accessible FAQ accordion pulled from the FAQ library, with FAQ rich-result schema.",
	"category": "mcrp",
	"icon": "editor-help",
	"keywords": [
		"faq",
		"questions",
		"accordion"
	],
	"textdomain": "mcrp",
	"supports": {
		"anchor": true,
		"align": false,
		"html": false,
		"mode": true,
		"jsx": false,
		"customClassName": true
	},
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php",
		"sectionStyle": true
	},
	"example": {
		"attributes": {
			"mode": "preview",
			"data": {
				"heading": "Frequently asked questions"
			}
		}
	}
}
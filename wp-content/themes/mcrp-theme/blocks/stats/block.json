{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "mcrp/stats",
	"title": "Stats",
	"description": "Animated key numbers \u2013 employment rates, students, programs.",
	"category": "mcrp",
	"icon": "chart-bar",
	"keywords": [
		"numbers",
		"counter",
		"facts"
	],
	"textdomain": "mcrp",
	"supports": {
		"anchor": true,
		"align": false,
		"html": false,
		"mode": true,
		"jsx": false,
		"customClassName": true
	},
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php",
		"sectionStyle": true
	},
	"example": {
		"attributes": {
			"mode": "preview",
			"data": {
				"heading": "Northbridge by the numbers"
			}
		}
	}
}